{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ai/*": ["src/ai/*"],
      "@app/*": ["src/app/*"],
      "@components/*": ["src/components/*"],
      "@config/*": ["src/config/*"],
      "@constants/*": ["src/constants/*"],
      "@contexts/*": ["src/contexts/*"],
      "@elements/*": ["src/elements/*"],
      "@hooks/*": ["src/hooks/*"],
      "@layout/*": ["src/layout/*"],
      "@lib/*": ["src/lib/*"],
      "@store/*": ["src/store/*"],
      "@styles/*": ["src/styles/*"],
      "@utils/*": ["src/utils/*"]
    },

    /* Bundler mode */
    "composite": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "outDir": "./dist", 
    "rootDir": "./src",
    "noEmit": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    // "skipLibCheck": true,      // 라이브러리 타입 오류 무시 (중복 제거)
    "noEmitOnError": false    // 에러가 있어도 .js 파일 생성
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}